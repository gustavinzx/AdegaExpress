{
  "name": "adega-express-backend",
  "version": "2.0.0",
  "description": "Backend da Adega Express - Node.js + Express + TypeScript + Prisma",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --project tsconfig.check.json",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "lint:fix": "eslint src --ext .ts --fix",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "seed:demo": "tsx prisma/seed-demo.ts",
    "test": "node --import tsx --test tests/unit.test.ts",
    "test:integration": "node scripts/test-integration.mjs",
    "check": "npm run prisma:generate && npm run typecheck && npm run lint && npm test && npm run build",
    "check:all": "npm run check && npm run test:integration",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"prisma/*.ts\" \"scripts/*.mjs\" \"docs/*.md\" README.md package.json tsconfig*.json .prettierrc.json .eslintrc.json",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"prisma/*.ts\" \"scripts/*.mjs\" \"docs/*.md\" README.md package.json tsconfig*.json .prettierrc.json .eslintrc.json"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "cpf-cnpj-validator": "^2.1.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "googlethis": "^1.8.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "playwright": "^1.63.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "mysql2": "^3.24.4",
    "prettier": "^3.9.8",
    "prisma": "^5.14.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
