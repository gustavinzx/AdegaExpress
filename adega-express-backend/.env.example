# API na porta 3001; frontend futuro na porta 3000.
PORT=3001
NODE_ENV=development
DATABASE_URL="mysql://adega_app:SENHA_URL_ENCODED@127.0.0.1:3306/adega_express"

# npm run setup gera este segredo SOMENTE quando .env ainda não existe.
JWT_SECRET="GENERATE_WITH_NPM_RUN_SETUP"
JWT_EXPIRES_IN="8h"
CORS_ORIGINS="http://localhost:3000"
# 0 para acesso direto; configure a quantidade exata de proxies no deploy.
TRUST_PROXY_HOPS=0

# Taxa fixa local em BRL; zero significa entrega gratuita por configuração.
SHIPPING_FEE=0.00
# Lista de cidades separadas por vírgula; vazia não restringe a cidade.
DELIVERY_CITIES=""
# Descomente para limitar a UF.
# DELIVERY_STATE=SP

# Somente para criar o primeiro administrador com npm run seed.
ADMIN_NAME="Administrador Adega Express"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# Testes: defina as variáveis abaixo NO TERMINAL, conforme README.
# O executor isolado não lê estas opções do .env da aplicação.
# MYSQLD_BIN="C:/Program Files/MySQL/MySQL Server 8.0/bin/mysqld.exe"
# Alternativa: banco VAZIO separado com nome adega_test_..., nunca banco de uso.
# TEST_DATABASE_URL="mysql://usuario:senha@127.0.0.1:3306/adega_test_verificacao"
